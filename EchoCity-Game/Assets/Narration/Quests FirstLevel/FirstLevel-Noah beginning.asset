  dialogLines:
  - speakerName: Noah
    dialogText: "All right, I have to get out of here...\LThis place is a disaster.\LBut
      before I leave, I need to gather a few things.\LLuckily, I still have the echolocator
      on me.\LI\u2019ll need some tools to make it work properly and find my way."
    audioClip: {fileID: 8300000, guid: e483ebb31922b4c089b23819e96e880a, type: 3}
