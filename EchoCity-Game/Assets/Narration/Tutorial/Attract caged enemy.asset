MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a0711db1b03ce448c93419c25aa574d8, type: 3}
  m_Name: Attract caged enemy
  m_EditorClassIdentifier: 
  dialogLines:
  - speakerName: EcholocalizerAI
    dialogText: "Let\u2019s run a complete test, Noah.\nFirst, move slowly closer
      to the cage \u2014 don\u2019t rush.\nKeep your eyes on the bar at the top of
      the screen: it represents the attraction you\u2019re generating around you.\n\nNow
      use a high frequency near the cage.\nListen carefully: the sound becomes sharper,
      and the space appears clearer \u2014 but you\u2019re making yourself louder.\nIf
      the creature detects you, you\u2019ll see a red dot appear above its head.
      That means its attention is now on you.\n\nStay calm.\nReduce the noise or
      switch to low frequencies and watch the bar slowly go back down.\nThis is the
      rule: more detail means more danger \u2014 less noise means safety.\nTry it
      now."
    audioClip: {fileID: 8300000, guid: ee7d0d39903274e89af637a31c9dbc04, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: "Very well done. \nWelcome to the Resonance Project, Noah.\nTraining
      complete."
    audioClip: {fileID: 8300000, guid: 4f13192969b3ed843ac0d079dc6513df, type: 3}
