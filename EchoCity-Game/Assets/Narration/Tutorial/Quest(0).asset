MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a0711db1b03ce448c93419c25aa574d8, type: 3}
  m_Name: Quest(0)
  m_EditorClassIdentifier: 
  dialogLines:
  - speakerName: Kael
    dialogText: "Ehi Noah. Le Resonance Towers stanno dando risultati migliori del
      previsto\u2026 almeno in superficie l\u2019aria sembra pi\xF9 pulita. Ma\u2014
      continuo ad avere dubbi."
    audioClip: {fileID: 8300000, guid: ee7d0d39903274e89af637a31c9dbc04, type: 3}
  - speakerName: Kael
    dialogText: "Eppure, in alcune zone, qualcosa sta cambiando troppo in fretta.
      Qualcosa sta\u2026 crescendo."
    audioClip: {fileID: 0}
  - speakerName: Kael
    dialogText: "Questo \xE8 il primo esemplare che siamo riusciti a catturare. L\u2019hanno
      trovato nel settore est di Prinswist, dopo una serie di incidenti strani."
    audioClip: {fileID: 0}
  - speakerName: Kael
    dialogText: "Non sappiamo ancora se \xE8 una reazione chimica, biologica\u2026
      o qualcosa di completamente diverso. E peggiora ogni giorno."
    audioClip: {fileID: 0}
  - speakerName: Kael
    dialogText: "Si muove solo quando sente certi suoni. Non reagisce a tutto, sceglie.
      \xC8 come se\u2026 stesse leggendo l\u2019ambiente con l\u2019udito."
    audioClip: {fileID: 0}
  - speakerName: Kael
    dialogText: "\xC8 per questo che sei qui, Noah. Voglio capire se c\u2019\xE8
      un pattern. Benvenuto nella Factory."
    audioClip: {fileID: 0}
  - speakerName: Kael
    dialogText: "Ti far\xF2 usare il nostro ultimo prototipo: un ecolocalizzatore.
      Se funziona come penso\u2026 vedremo quello che lui \u201Csente\u201D."
    audioClip: {fileID: 0}
  - speakerName: Kael
    dialogText: "Osserva, studia. E cerca di non fare troppo rumore. Io torno ad
      analizzare i dati\u2026 qualcosa non torna."
    audioClip: {fileID: 0}
