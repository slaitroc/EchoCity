  dialogLines:
  - speakerName: EcholocalizerAI
    dialogText: "Now pick up your ID badge, on the table in the center.\nIt certifies
      your role as an engineer of the Resonance Project.\nOnly a few ever make it
      this far \u2014 it takes real talent to wear it."
    audioClip: {fileID: 8300000, guid: ee7d0d39903274e89af637a31c9dbc04, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: 'The object is now in your inventory.

      Collect tools that might
      be useful. '
