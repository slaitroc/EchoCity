  m_Script: {fileID: 11500000, guid: a0711db1b03ce448c93419c25aa574d8, type: 3}
  m_Name: Use High SoundTool
  m_EditorClassIdentifier: 
  dialogLines:
  - speakerName: EcholocalizerAI
    dialogText: "With high frequencies you see a lot of detail, but it\u2019s like
      shouting into the monsters\u2019 ears: you attract them much more."
    audioClip: {fileID: 8300000, guid: ee7d0d39903274e89af637a31c9dbc04, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: "Good. Now you know that the higher the frequency, the more detail
      you see\u2026 and the more easily you are heard."
    audioClip: {fileID: 8300000, guid: 4f13192969b3ed843ac0d079dc6513df, type: 3}
