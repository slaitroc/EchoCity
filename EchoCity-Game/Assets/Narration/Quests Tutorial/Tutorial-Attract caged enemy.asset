%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a0711db1b03ce448c93419c25aa574d8, type: 3}
  m_Name: Tutorial-Attract caged enemy
  m_EditorClassIdentifier: 
  dialogLines:
  - speakerName: EcholocalizerAI
    dialogText: "Let\u2019s run a complete test, Noah.\nFor this phase, the room
      must stay in darkness."
    audioClip: {fileID: 8300000, guid: 13e28a4756c2b4bb98bb54eed2995e5b, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: "These creatures become extremely powerful when exposed to light
      \u2014 their muscles overstimulate, they panic, and they can break through
      containment.\n"
    audioClip: {fileID: 8300000, guid: d6aa2de26f8164ca392ffe5af0840830, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: This subject, however, has been sedated for testing purposes and
      will not react.
    audioClip: {fileID: 8300000, guid: a17957091dd984b7fb456b58ca317d02, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: "Move slowly toward the cage \u2014 do not rush.\nKeep your eyes
      on the bar at the top of the screen: it shows the attraction you are generating
      around you."
    audioClip: {fileID: 8300000, guid: ac18f9c2543614e58b470c2d2ffe9f5f, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: "Now use a high frequency near the cage.\nThe sound becomes sharper
      and the space looks clearer \u2014 but you are making yourself louder."
    audioClip: {fileID: 8300000, guid: 7dfc6c9b6ab7742d58e0b85e2d624d5d, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: ' If the creature detects you, a red dot will appear above its head.
      That means its attention is locked on you.'
    audioClip: {fileID: 8300000, guid: aefbb1fd36c034a31b2b6e2ad9ba9056, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: 'Stay calm. Stop emitting sound. Move away from the creature immediately. '
    audioClip: {fileID: 8300000, guid: c958bdfec3eeb4c60a5dcf507406c3fd, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: "Keeping distance is the safest option. This is the rule: more detail
      means more danger \u2014 less noise means safety."
    audioClip: {fileID: 8300000, guid: 966d6d349fd154908bbea7994c0d9555, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: Try it now.
    audioClip: {fileID: 8300000, guid: fbe0901b4ba774368a79de5e948bb687, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: "Very well done. \nWelcome to the Resonance Project, Noah.\nTraining
      complete."
    audioClip: {fileID: 8300000, guid: 7cd822cbfa84040a695232519042eb44, type: 3}
