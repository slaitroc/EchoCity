--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a0711db1b03ce448c93419c25aa574d8, type: 3}
  m_Name: Attract caged enemy
  m_EditorClassIdentifier: 
  dialogLines:
  - speakerName: EcholocalizerAI
    dialogText: "Let\u2019s run a complete test, Noah.\nFor this phase, the room
      must stay in darkness.\nThese creatures become extremely powerful when exposed
      to light \u2014 their muscles overstimulate, they panic, and they can break
      through containment.\nThis subject, however, has been sedated for testing purposes
      and will not react.\n\nMove slowly toward the cage \u2014 do not rush.\nKeep
      your eyes on the bar at the top of the screen: it shows the attraction you
      are generating around you.\n\nNow use a high frequency near the cage.\nThe
      sound becomes sharper and the space looks clearer \u2014 but you are making
      yourself louder.\nIf the creature detects you, a red dot will appear above
      its head. That means its attention is locked on you.\n\nStay calm.\nStop emitting
      sound.\nMove away from the creature immediately.\nKeeping distance is the safest
      option.\nThis is the rule: more detail means more danger \u2014 less noise
      means safety.\nTry it now."
    audioClip: {fileID: 8300000, guid: 13e28a4756c2b4bb98bb54eed2995e5b, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: "Very well done. \nWelcome to the Resonance Project, Noah.\nTraining
      complete."
    audioClip: {fileID: 8300000, guid: 7cd822cbfa84040a695232519042eb44, type: 3}
