%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a0711db1b03ce448c93419c25aa574d8, type: 3}
  m_Name: Tutorial-Use High SoundTool
  m_EditorClassIdentifier: 
  dialogLines:
  - speakerName: EcholocalizerAI
    dialogText: 'Equip the high frequency tool.

      High frequencies reveal everything
      detected by low and medium frequencies,

      including small and highly detailed
      objects.

'
    audioClip: {fileID: 8300000, guid: 4c0acf4c205ac4fdd9c601e793fdff56, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: "Good. Now you know that the higher the frequency, the more detail
      you see\u2026\nSound is everything."
    audioClip: {fileID: 8300000, guid: 81fab2294c0e8450ca81527c2b2086c0, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: 'This level of detail comes at a cost.

      The sound is intense,
      and monsters are strongly attracted.'
    audioClip: {fileID: 8300000, guid: f01b9887e2d564aa8a9996afb7269d96, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: 'Each tool produces a different level of noise

      and reveals
      a different level of detail.

      Open your inventory and observe the parameters
      of each tool.'
    audioClip: {fileID: 8300000, guid: 0be020bbea1aa45fc874e10b1337364d, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: 'Use them to decide when to stay quiet,

      and when higher detail
      is worth the risk.

      Some objects require precision.'
    audioClip: {fileID: 8300000, guid: f9ffcd7adb09c4107a60838157ce60e2, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: 'A small key on a table, for example,

      can only be detected
      at high frequencies.

      Choose carefully.'
    audioClip: {fileID: 8300000, guid: 8ed9f4268173c4d229f8d9dfbfdbc199, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: "What you hear \u2014 and what hears you \u2014\ndepends entirely
      on the sound you produce."
    audioClip: {fileID: 8300000, guid: b7442009d4d4e45d4bcdc0bfdeae265f, type: 3}
