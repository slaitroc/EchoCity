MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a0711db1b03ce448c93419c25aa574d8, type: 3}
  m_Name: Tutorial-Use High SoundTool
  m_EditorClassIdentifier: 
  dialogLines:
  - speakerName: EcholocalizerAI
    dialogText: 'Equip the high frequency tool.

      High frequencies reveal everything
      detected by low and medium frequencies,

      including small and highly detailed
      objects.

      This level of detail comes at a cost.

      The sound is intense,
      and monsters are strongly attracted.'
    audioClip: {fileID: 8300000, guid: 4c0acf4c205ac4fdd9c601e793fdff56, type: 3}
  - speakerName: EcholocalizerAI
    dialogText: "Good. Now you know that the higher the frequency, the more detail
      you see\u2026\nSound is everything.\nEach tool produces a different level of
      noise\nand reveals a different level of detail.\nOpen your inventory and observe
      the parameters of each tool.\nUse them to decide when to stay quiet,\nand when
      higher detail is worth the risk.\nSome objects require precision.\nA small
      key on a table, for example,\ncan only be detected at high frequencies.\nChoose
      carefully.\nWhat you hear \u2014 and what hears you \u2014\ndepends entirely
      on the sound you produce.\n "
    audioClip: {fileID: 8300000, guid: 81fab2294c0e8450ca81527c2b2086c0, type: 3}
