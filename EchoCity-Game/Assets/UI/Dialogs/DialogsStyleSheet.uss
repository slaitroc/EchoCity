.dialog-root {
    position: absolute;
    bottom: 40px;
    width: 100%;
    justify-content: center;
    display: flex;
    pointer-events: none;
}

.textbox {
    white-space: normal;
    width: 80%;
    min-height: 200px;
    background-color: rgba(0, 0, 0, 0.7);
    border-radius: 12px;
    padding: 16px;
    pointer-events: auto;
    align-self: center;
}

.speaker-label {
    unity-font-style: bold;
    font-size: 32px;
    margin-bottom: 5px;
    color: rgb(255, 210, 127);
}

.dialog-label {
    font-size: 26px;
    color: white;
}

.button-container {
    height: 100%;
    top: 0;
    bottom: 0;
    right: 10px;
    display: flex;
    gap: 10px;
    padding: 2px;
    justify-content: space-between;
    position: absolute;
}

.skip-button {
    position: relative;
    background-color: rgba(255, 210, 127, 0.4);
    border-width: 5px;
    border-color: transparent;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 20px;
    color: white;
    cursor: pointer;
    top: 10px;
}

.continue-button {
    position: relative;
    bottom: 10px;
    background-color: rgba(255, 255, 255, 0.2);
    border-width: 5px;
    border-color: transparent;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 20px;
    color: white;
    cursor: pointer;
}

.button:focus,
.button:hover {
    border-color: rgba(0, 255, 0, 0.5);
}

