<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/WinMenu/WinMenuStyleSheet.uss?fileID=7433441132597879392&amp;guid=d0bfe5a259de8484cba98038c179bfb9&amp;type=3#WinMenuStyleSheet" />
    <ui:VisualElement name="WinMenuRoot" class="win-menu-root">
        <ui:VisualElement name="WinBgStatic" class="win-bg-static" />
        <ui:VisualElement name="WinMenuPanel" class="panel">
            <ui:Label name="title" text="You&apos;ve escaped the Bunker" class="title" />
            <ui:Button name="RestartButton" text="Restart" class="button" />
            <ui:Button name="FeedbackButton" text="Feedback" class="button" />
            <ui:Button name="QuitButton" text="Quit to Title" class="button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
