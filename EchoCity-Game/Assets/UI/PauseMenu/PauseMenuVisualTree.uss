.pause-root:disabled {
    opacity: 0;
    transition-duration: 1s;
}

.pause-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    transition-property: opacity;
    transition-duration: 200ms;
    transition-timing-function: ease-in-out;
}

.dimmer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.8);
    opacity: 1;
}

.panel {
    width: 70%;
    height: 70%;
    background-color: rgba(29, 29, 29, 0.95);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 24px;
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
}

.title {
    -unity-font-style: normal;
    font-size: 100px;
    color: white;
    margin-top: auto;
    margin-bottom: auto;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/LocalPackages/Echotopia_Font/Echotopia-Regular.otf?fileID=12800000&guid=bbfdabf7e80c84e8183948de3149f98e&type=3#Echotopia-Regular");
}

.button {
    height: 15%;
    width: 80%;
    align-self: center;
    font-size: 500%;
    margin: 20px;
    background-color: rgb(0, 0, 0);
    color: white;
    border-radius: 15px;
    align-content: center;
    align-items: center;
    -unity-font-definition: url("project://database/Assets/LocalPackages/Echotopia_Font/Echotopia-Regular.otf?fileID=12800000&guid=bbfdabf7e80c84e8183948de3149f98e&type=3#Echotopia-Regular");
    transition-duration: 0.5s;
    background-image: url("project://database/Assets/LocalPackages/PolygonApocalypse/Textures/Misc/PolygonApocalypse_Blood_Alt.png?fileID=2800000&guid=3cdfe517960b2ac4d8cdcd666a5654dd&type=3#PolygonApocalypse_Blood_Alt");
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.button:hover {
    border-color: rgb(255, 0, 0);
    background-image: url("project://database/Assets/LocalPackages/PolygonApocalypse/Textures/Misc/PolygonApocalypse_Blood.png?fileID=2800000&guid=ab3c9c81285cc4443b3b62ab3ba16da7&type=3#PolygonApocalypse_Blood");
    scale: 1.2 1.2;
    -unity-background-image-tint-color: rgb(106, 0, 0);
}

.button:focus {
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
    background-image: url("project://database/Assets/LocalPackages/PolygonApocalypse/Textures/Misc/PolygonApocalypse_Blood.png?fileID=2800000&guid=ab3c9c81285cc4443b3b62ab3ba16da7&type=3#PolygonApocalypse_Blood");
    scale: 1.2 1.2;
    -unity-background-image-tint-color: rgb(106, 0, 0);
}

.button:hover {
    border-color: rgb(0, 255, 0);
}
