/* ROOT OVERLAY */
.subtitles-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    /* Subtitles should never block gameplay input */
    pointer-events: none;
}

/* BOTTOM SAFE ANCHOR */
.subtitles-anchor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding-left: 6%;
    padding-right: 6%;

    /* Transition */
    transition-property: translate;
    transition-duration: 180ms;
    transition-timing-function: ease-out;

    /* Default */
    translate: 0 0;
}

/* PANEL */
.subtitles-panel {
    opacity: 1;
    
    max-width: 70%;
    /* max-width: 1400px; */

    display: flex;
    flex-direction: column;
    gap: 6px;

    padding: 12px 16px;

    /* background-color: rgba(0, 0, 0, 0.65); */
    border-radius: 12px;

    /* border-width: 1px; */
    /* border-style: solid; */
    /* border-color: rgba(255, 255, 255, 0.18); */

    transition: opacity 0.3s ease-in-out;
    
}

/* SPEAKER */
.subtitles-speaker {
    unity-font-style: bold;

    /* Keep it slightly smaller than main dialog speaker (you used 32 there) */
    font-size: 26px;

    color: rgba(140, 220, 215, 0.95);
    opacity: 0.95;

}

/* TEXT */
.subtitles-text {
    white-space: normal;
    unity-text-align: middle-center;

    /* Subtitle size: close to your dialog 26, but safe on small screens */
    font-size: 26px;

    color: rgba(255, 255, 255, 0.98);
}

/* VISIBILITY TOGGLE (controlled by code) */
.subtitles-panel.hidden {
    opacity: 0;
}

.subtitles-panel.visible {
    opacity: 1;
}

