.settings-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.6);
}

.settings-title {
    -unity-font-style: normal;
    font-size: 100px;
    color: white;
    margin-top: auto;
    margin-bottom: auto;
    -unity-text-align: middle-center;
    -unity-font-definition: resource('Fonts/EchoCity-Echotopia-Regular');
}

.settings-panel {
    width: 70%;
    height: 70%;
    background-color: rgba(29, 29, 29, 0.95);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 24px;
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
}

.settings-header {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 20px;
    margin-top: 20px;
}

.settings-section-title {
    font-size: 48px;
    color: rgb(255, 154, 104);
    margin-top: 20px;
    -unity-font-definition: resource('Fonts/EchoCity-Echotopia-Regular');
    width: 70%;
    margin-left: auto;
    margin-right: auto;
    -unity-text-align: middle-center;
}

.settings-slider-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 40px;
    margin: 20px 0;
    width: 70%;
    margin-left: auto;
    margin-right: 50%;
    justify-content: flex-end;
}

.settings-slider-label {
    min-width: 200px;
    max-width: 300px;
    font-size: 48px;
    color: white;
    -unity-font-definition: resource('Fonts/EchoCity-Echotopia-Regular');
    -unity-text-align: middle-right;
    white-space: normal;
}

.settings-slider-container {
    flex-grow: 0;
    width: 60%;
    display: flex;
    flex-direction: row;
}

.settings-slider {
    width: 100%;
    height: 50px;
    margin-top: -10px;
    --unity-slider-background-color: rgb(40, 40, 72);
    --unity-slider-fill-color: rgb(154, 104, 255);
    --unity-slider-border-color: rgba(255, 255, 255, 0.2);
    border-radius: 25px;
}

.settings-slider-value {
    font-size: 32px;
    color: white;
    margin-left: 20px;
    -unity-font-definition: resource('Fonts/EchoCity-Echotopia-Regular');
    -unity-text-align: middle-right;
}

.settings-slider .unity-base-slider__drag-container {
    display: flex;
    justify-content: center;
}

.settings-slider .unity-base-slider__tracker {
    height: 12px;            
    margin-top: 5px;
    border-radius: 6px;
}

.settings-slider .unity-base-slider__dragger {
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background-color: white;
}

.settings-slider:hover .unity-base-slider__dragger {
    background-color: rgb(255, 154, 104);
}

.button-back {
    height: 15%;
    width: 80%;
    align-self: center;
    font-size: 500%;
    margin-top: 40px;
    margin-bottom: 20px;
    background-color: rgb(0, 0, 0);
    color: white;
    border-radius: 15px;
    align-content: center;
    align-items: center;
    -unity-font-definition: resource('Fonts/EchoCity-Echotopia-Regular');
    transition-duration: 0.5s;
    background-image: resource('Images/EchoCity-PolygonApocalypse_Blood');
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.button-back:hover {
    border-color: rgb(255, 0, 0);
    background-image: resource('Images/EchoCity-PolygonApocalypse_Blood');
    scale: 1.2 1.2;
    -unity-background-image-tint-color: rgb(106, 0, 0);
}

.button-back:focus {
    border-color: rgb(255, 0, 0);
    background-image: resource('Images/EchoCity-PolygonApocalypse_Blood');
    scale: 1.2 1.2;
    -unity-background-image-tint-color: rgb(106, 0, 0);
}
