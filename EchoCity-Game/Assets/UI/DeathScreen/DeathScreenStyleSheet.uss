.death-screen-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;

    overflow: hidden;
}


.death-bg-static {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: resource('Images/EchoCity-DeathScreen1');
    -unity-background-scale-mode: scale-and-crop;
}

.death-bg-animated {
    position: absolute;
    width: 100%;
    height: 100%;
    translate: 0 -70%;
    background-image: resource('Images/EchoCity-DeathScreen2');
    -unity-background-scale-mode: scale-and-crop;
    transition: translate 10s ease-out;
}

.panel {
    opacity: 0;
    width: 70%;
    height: 70%;
    border-radius: 16px;
    border-width: 1px;
    padding: 24px;
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    transition-property: opacity;
    transition-duration: 3s;
    transition-timing-function: ease-in-out;
}

.panel.show {
    opacity: 1;
}


.title {
    font-size: 160px;
    color: rgb(255, 50, 50);
    text-shadow: 0 0 25px rgb(120, 0, 0), 0 0 10px rgb(80, 0, 0);
    margin-bottom: 120px;
    -unity-text-align: middle-center;
    -unity-font-definition: resource('Fonts/EchoCity-Echotopia-Regular');
}

.button {
    height: 15%;
    width: 80%;
    align-self: center;
    font-size: 500%;
    margin: 20px;
    background-color: rgb(0, 0, 0);
    color: white;
    border-radius: 15px;
    align-content: center;
    align-items: center;
    -unity-font-definition: resource('Fonts/EchoCity-Echotopia-Regular');
    transition-duration: 0.5s;
    background-image: resource('Images/EchoCity-PolygonApocalypse_Blood');
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(0, 0, 0);
}

.button:hover,
.button:focus {
    border-color: rgb(255, 0, 0);
    background-image: resource('Images/EchoCity-PolygonApocalypse_Blood');
    scale: 1.2 1.2;
    -unity-background-image-tint-color: rgb(106, 0, 0);
}

