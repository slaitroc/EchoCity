.loading-screen {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: black;
    justify-content: center;
    align-items: center;
    display: flex;
    z-index: 9999;
}

.spinner {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    background-image: resource('Images/EchoCity-LoadingScreen');
}

.loading-text {
    position: absolute;
    tranlsate: -50% -50%;
    font-size: 60px;
    color: white;
    unity-font-style: bold;
    margin-top: 50px;
    letter-spacing: 2px;
    text-shadow: 0 0 6px rgba(255, 255, 255, 0.4);
    opacity: 0.9;
    -unity-font-definition: resource('Fonts/EchoCity-Echotopia-Regular');
}
