.hud-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.crosshair-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
}

.crosshair {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border-width: 2px;
    border-style: solid;
    border-color: white;
    background-color: transparent;
    opacity: 0.9;
    border-left-color: rgb(135, 135, 135);
    border-right-color: rgb(135, 135, 135);
    border-top-color: rgb(135, 135, 135);
    border-bottom-color: rgb(135, 135, 135);
    transition-duration: 0.1s;
    transition-timing-function: ease-in-out;
}

.crosshair.interact {
    background-color: rgb(255, 221, 85);
    width: 25px;
    height: 25px;
}

.interaction-panel {
    position: absolute;
    bottom: 6%;
    left: 50%;
    translate: -50% 10px;
    width: auto;
    height: auto;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 20px;
    background-color: rgba(0, 0, 0, 0.65);
    -unity-background-image-tint-color: white;
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    pointer-events: none;
    flex-direction: row;
    justify-content: center;
}

.interaction-panel.visible {
    opacity: 1;
    translate: -50% 0;
}

.interaction-key {
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 6px;
    border-width: 1px;
    border-style: solid;
    border-color: rgb(255, 255, 255);
    unity-text-align: middle-center;
    font-size: 200%;
    font-weight: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.05);
    min-width: 50px;
    min-height: 50px;
    background-image: url("project://database/Assets/UI/GameInputControllerIcons/mouse/mouse-outlined/mouse-left.png?fileID=2800000&guid=fd1a0dff4c167f04898c69eedd2b810c&type=3#mouse-left");
}

.interaction-text {
    font-size: 300%;
    color: rgb(255, 255, 255);
    unity-text-align: middle-left;
    opacity: 0.9;
}

/* radial menu */
.radial-menu-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* display: none;           */
    justify-content: center;
    align-items: center;
    pointer-events: none;
}

.radial-menu-root.active {
    display: flex;
    pointer-events: auto;
}

.radial-center {
    width: 500px;
    height: 500px;
    border-radius: 50%;
    border-width: 2px;
    border-style: solid;
    /* border-color: rgba(255, 255, 255, 0.13); */
    justify-content: center;
    align-items: center;
    position: relative;
}

.radial-item {
    position: absolute;
    width: 120px;
    height: 120px;
    border-radius: 60px;
    justify-content: center;
    align-items: center;
    background-color: rgba(19, 157, 226, 0.5);
    border-width: 2px;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.27);
    -unity-font-style: bold;
}

/* 
#Item_1 {
    top: 0;
    left: 50%;
    translate: -50% -50%;
}
#Item_2 {
    top: 50%;
    right: 0;
    translate: 50% -50%;
}
#Item_3 {
    bottom: 0;
    left: 50%;
    translate: -50% 50%;
}
#Item_4 {
    top: 50%;
    left: 0;
    translate: -50% -50%;
} */


.radial-item.hovered {
    background-color: rgba(154, 104, 255, 0.80);
    border-color: rgba(255, 127, 80, 1.0);
}


.radial-info-panel {
    position: absolute;
    width: 220px;
    padding: 10px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.85);
    border-width: 2px;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.25);
    color: white;
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    pointer-events: none;
    z-index: 999;
}

#RadialInfoText {
    font-size: 14px;
    -unity-font-style: bold;
    white-space: normal;
}
