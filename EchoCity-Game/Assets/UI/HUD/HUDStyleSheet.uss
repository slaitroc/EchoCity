.hud-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.crosshair-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
}

.crosshair {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border-width: 2px;
    border-style: solid;
    border-color: white;
    background-color: transparent;
    opacity: 0.9;
    border-left-color: rgb(135, 135, 135);
    border-right-color: rgb(135, 135, 135);
    border-top-color: rgb(135, 135, 135);
    border-bottom-color: rgb(135, 135, 135);
    transition-duration: 0.1s;
    transition-timing-function: ease-in-out;
}

.crosshair.interact {
    background-color: rgb(255, 221, 85);
    width: 25px;
    height: 25px;
}

.interaction-panel {
    position: absolute;
    bottom: 6%;
    left: 50%;
    translate: -50% 10px;
    width: auto;
    height: auto;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 20px;
    background-color: rgba(0, 0, 0, 0.65);
    -unity-background-image-tint-color: white;
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    pointer-events: none;
    flex-direction: row;
    justify-content: center;
}

.interaction-panel.visible {
    opacity: 1;
    translate: -50% 0;
}

.interaction-key {
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 6px;
    border-width: 1px;
    border-style: solid;
    border-color: rgb(255, 255, 255);
    unity-text-align: middle-center;
    font-size: 200%;
    font-weight: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.05);
    min-width: 50px;
    min-height: 50px;
    background-image: url("project://database/Assets/LocalPackages/GameInputControllerIcons/mouse/mouse-outlined/mouse-left.png?fileID=2800000&guid=fd1a0dff4c167f04898c69eedd2b810c&type=3#mouse-left");
}

.interaction-text {
    font-size: 300%;
    color: rgb(255, 255, 255);
    unity-text-align: middle-left;
    opacity: 0.9;
}

.radial-menu-root {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    opacity: 0;
    justify-content: center;
    align-items: center;
    pointer-events: none;
    display: none;
    transition-property: opacity, scale;
    transition-duration: 200ms;
    transition-timing-function: ease-in-out;
}

.radial-menu-root.active {
    opacity: 1;
    display: flex;
    pointer-events: auto;
}

.radial-center {
    width: 500px;
    height: 500px;
    border-radius: 50%;
    border-width: 2px;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.13);
    justify-content: center;
    align-items: center;
    position: relative;
}

.radial-item {
    width: 200px;
    height: 200px;
    border-radius: 100px;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.75);
    border-width: 2px;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.5);
    -unity-font-style: bold;
    position: absolute;
    transform-origin: 50% 200%;
    color: rgb(255, 255, 255);
    translate: 0 -300px;
}

.radial-item:hover {
    cursor: pointer;
    background-color: rgba(154, 104, 255, 0.6);
    border-color: rgb(255, 127, 80);
}

.item-0 {rotate: 0;}
.item-0 .radial-item-content{rotate: 0deg;}
.item-1 {rotate: 45deg;}
.item-1 .radial-item-content{rotate: -45deg;}
.item-2 {rotate: 90deg;}
.item-2 .radial-item-content{rotate: -90deg;}
.item-3 {rotate: 135deg;}
.item-3 .radial-item-content{rotate: -135deg;}
.item-4 {rotate: 180deg;}
.item-4 .radial-item-content{rotate: -180deg;}
.item-5 {rotate: 225deg;}
.item-5 .radial-item-content{rotate: -225deg;}
.item-6 {rotate: 270deg;}
.item-6 .radial-item-content{rotate: -270deg;}
.item-7 {rotate: 315deg;}
.item-7 .radial-item-content{rotate: -315deg;}

.radial-item-content {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    text-align: center;
    font-size: 32px;
}


.radial-item.hovered {
    background-color: rgba(154, 104, 255, 0.8);
    border-color: rgb(255, 127, 80);
}

.radial-info-panel {
    position: absolute;
    width: 380px;             
    min-height: 100px;
    max-height: 230px;
    justify-content: center;
    align-items: center;
    padding: 8px 12px;
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.4);
    border-style: solid;
}

.radial-info-title {
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
    color: rgb(255, 255, 255);
}

.radial-info-text {
    font-size: 18px;
    margin-top: 4px;
    white-space: normal;
    opacity: 0.9;
    color: rgb(200, 200, 200);
}

.warning-panel {
    opacity: 1;
    position: absolute;
    bottom: 50px;
    width: 100%;
    min-height: 60px;
    display: none;
    justify-content: center;
    pointer-events: none;
    transition-property: opacity;
    transition-duration: 0ms;
}

.warning-panel.hide {
    opacity: 0;
    transition-duration: 500ms;
    transition-timing-function: ease-in;
}

.warning-box {
    position: absolute;
    width: 50%;
    padding: 8px 16px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.75);
    border-width: 2px;
    border-style: solid;
    border-color: rgba(255, 0, 0, 1);
    align-self: center;
    justify-content: center;
    align-items: center;
}

.warning-text {
    font-size: 18px;
    color: rgba(255, 0, 0, 1);
    -unity-font-style: bold;
    unity-text-align: middle-center;
}