/* HUD Style Sheet */
.hud-root {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}


/* CROSSHAIR */
.crosshair-layer {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    pointer-events: none;
}

.crosshair {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border-width: 2px;
    border-style: solid;
    border-color: white;
    background-color: transparent;
    opacity: 0.9;
    border-left-color: rgb(135, 135, 135);
    border-right-color: rgb(135, 135, 135);
    border-top-color: rgb(135, 135, 135);
    border-bottom-color: rgb(135, 135, 135);
    transition-duration: 0.1s;
    transition-timing-function: ease-in-out;
}

.crosshair.interact {
    background-color: rgb(255, 221, 85);
    width: 25px;
    height: 25px;
}

.crosshair.no-interact {
    background-color: rgba(55, 55, 55, 1);
    width: 20px;
    height: 20px;
}


/* INTERACTION PANEL */
.interaction-panel {
    position: absolute;
    bottom: 40px;
    left: 50%;
    translate: -50% 10px;
    width: auto;
    height: auto;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 20px;
    background-color: rgba(0, 0, 0, 0.65);
    -unity-background-image-tint-color: white;
    opacity: 0;
    transition-property: opacity, translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
    pointer-events: none;
    flex-direction: row;
    justify-content: center;
}

.interaction-panel.visible {
    opacity: 1;
    translate: -50% 0;
}

.interaction-key {
    padding-left: 6px;
    padding-right: 6px;
    border-radius: 6px;
    border-width: 1px;
    border-style: solid;
    border-color: rgb(255, 255, 255);
    unity-text-align: middle-center;
    font-size: 200%;
    font-weight: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.05);
    min-width: 50px;
    min-height: 50px;
    background-image: resource('Icons/EchoCity-mouse-left');
}

.interaction-text {
    font-size: 20px;
    color: rgb(255, 255, 255);
    unity-text-align: middle-left;
    opacity: 0.9;
}


/* RADIAL MENU */
.radial-menu-root {
    opacity: 0;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    pointer-events: none;
    display: flex;
    transition-property: opacity, scale;
    transition-duration: 200ms;
    transition-timing-function: ease-in-out;
}

.radial-menu-root.active {
    opacity: 1;
    pointer-events: auto;
}


.radial-center {
    width: 500px;
    height: 500px;
    border-radius: 50%;
    border-width: 2px;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.13);
    justify-content: center;
    align-items: center;
    position: relative;
}

.radial-item {
    width: 200px;
    height: 200px;
    border-radius: 100px;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.75);
    border-width: 2px;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.5);
    -unity-font-style: bold;
    position: absolute;
    transform-origin: 50% 200%;
    color: rgb(255, 255, 255);
    translate: 0 -300px;
    display: none;
}

.radial-item:hover {
    cursor: pointer;
    background-color: rgba(154, 104, 255, 0.6);
    border-color: rgb(255, 127, 80);
}

.item-0 {
    rotate: 0;
}

.item-0 .radial-item-content {
    rotate: 0;
}

.item-1 {
    rotate: 45deg;
}

.item-1 .radial-item-content {
    rotate: -45deg;
}

.item-2 {
    rotate: 90deg;
}

.item-2 .radial-item-content {
    rotate: -90deg;
}

.item-3 {
    rotate: 135deg;
}

.item-3 .radial-item-content {
    rotate: -135deg;
}

.item-4 {
    rotate: 180deg;
}

.item-4 .radial-item-content {
    rotate: -180deg;
}

.item-5 {
    rotate: 225deg;
}

.item-5 .radial-item-content {
    rotate: -225deg;
}

.item-6 {
    rotate: 270deg;
}

.item-6 .radial-item-content {
    rotate: -270deg;
}

.item-7 {
    rotate: 315deg;
}

.item-7 .radial-item-content {
    rotate: -315deg;
}

.radial-item-content {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    text-align: center;
    font-size: 32px;
}

.radial-item.hovered {
    background-color: rgba(154, 104, 255, 0.8);
    border-color: rgb(255, 127, 80);
}

.radial-info-panel {
    position: absolute;
    width: 380px;
    min-height: 100px;
    max-height: 230px;
    justify-content: center;
    align-items: center;
    padding: 8px 12px;
    background-color: rgba(0, 0, 0, 0.75);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.4);
    border-style: solid;
}

.radial-info-title {
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
    color: rgb(255, 255, 255);
}

.radial-info-text {
    font-size: 18px;
    margin-top: 4px;
    white-space: normal;
    opacity: 0.9;
    color: rgb(200, 200, 200);
}


/* RADIAL TOOLS TUTORIAL PANEL */
.tools-tutorial-panel {
    position: absolute;
    top: 40px;
    right: 40px;

    width: 500px;
    min-height: 60px;
    
    padding: 12px 16px;

    background-color: rgba(0, 0, 0, 0.65);
    border-radius: 8px;

    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.tools-properties-title {
    font-size: 18px;

    white-space: normal;
    -unity-text-align: middle-left;

    color: rgb(200, 200, 200);
    opacity: 0.95;

    letter-spacing: 0.3px;
}

.tools-tutorial-list {
    width: 100%;
    margin-top: 8px;

    display: flex;
    flex-direction: column;
    gap: 10px;
}

.tools-tutorial-entry {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.tools-tutorial-header {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    /* gap: 8px; */
    margin-top: 4px;
}

.tools-tutorial-icon {
    width: 24px;
    height: 24px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    opacity: 0.95;
}

.tools-tutorial-title {
    font-size: 22px;
    unity-font-style: bold;
    color: rgb(230, 230, 230);
}

.tools-tutorial-text {
    font-size: 20px;
    color: rgb(200, 200, 200);
    opacity: 0.95;
    white-space: normal;
    -unity-text-align: upper-left;
}

/* RADIAL INFO - PROPERTIES (CLASS + VOLUME) */
.radial-info-properties {
    width: 100%;
    margin-top: 10px;

    display: flex;
    flex-direction: row;
    gap: 8px;
}

.radial-info-class,
.radial-info-range {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 10px;
}

.radial-info-class-label,
.radial-info-range-label {
    font-size: 16px;
    color: rgb(200, 200, 200);
    opacity: 0.95;
}

.radial-info-class-icon,
.radial-info-transient-icon {
    width: 24px;
    height: 24px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    opacity: 0.95;
}

.radial-info-range-bar {
    flex-grow: 1;
    height: 10px;
    max-width: 110px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.15);
    overflow: hidden;
}

.radial-info-range-fill {
    height: 100%;
    width: 100%;
    border-radius: 6px;

    transform-origin: left center;
    background-color: rgba(154, 104, 255, 0.95);
}

.radial-info-range-ticks {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;

    display: flex;
    flex-direction: row;
    justify-content: space-between;

    padding-left: 6px; 
    padding-right: 6px;

    pointer-events: none;
}

.radial-info-range-tick {
    width: 2px;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.5);
}

/* WARNING PANEL */
.warning-panel {
    opacity: 0;
    position: absolute;
    top:80px;
    width: 100%;
    min-height: 60px;
    display: flex;
    justify-content: center;
    pointer-events: none;
    transition-property: opacity;
    transition-duration: 500ms;
    transition-timing-function: ease-in-out;
}

.warning-panel.show {
    opacity: 1;
}

.warning-box {
    position: absolute;
    width: 50%;
    padding: 8px 16px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.75);
    border-width: 2px;
    border-style: solid;
    border-color: rgb(255, 0, 0);
    align-self: center;
    justify-content: center;
    align-items: center;
}

.warning-text {
    font-size: 18px;
    color: rgb(255, 0, 0);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}


.tutorial-panel {
    position: absolute;
    max-width: 350px;
    bottom: 40px;
    right: 40px;
    padding: 18px 22px;
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
}

.tutorial-title-line {
    display: flex;
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.tutorial-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgba(238, 238, 238, 1);
    letter-spacing: 0.5px;
    margin-bottom: 10px;
    margin-right: 8px;
}

.tutorial-lines {
    display: flex;
    flex-direction: column;

}

.tutorial-line {
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 72px;
    margin-bottom: 24px;
    
}

.tutorial-line:last-child {
    margin-bottom: 0;
}

.tutorial-text {
    font-size: 20px;
    color: rgba(255, 255, 255, 1);
    -unity-font-style: normal;
    margin-right: 16px;
    white-space: normal;
}

.tutorial-key-icon {
    width: 56px;
    height: 56px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    margin-right: 16px;
}


/* EQUIPPED PANEL */
.equipped-panel {
    position: absolute;
    bottom: 40px;
    left: 40px;
    padding: 18px 22px;
    background-color: rgba(0,0,0,0.55);
    border-radius: 12px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.equipped-icon {
    width: 56px;
    height: 56px;
    background-color: rgba(255,255,255,0.1);
    border-radius: 8px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

.equipped-name {
    font-size: 20px;
    color: white;
    -unity-font-style: bold;
    margin-left: 8px;
}


/* ENEMY ATTRACTION PANEL */
.enemy-attraction-panel {
    position: absolute;
    top: 40px;
    left: 50%;
    translate: -50% -10px;

    padding: 8px 16px;
    min-width: 260px;
    max-width: 420px;

    display: flex;
    flex-direction: column;
    gap: 6px;

    background-color: rgba(0, 0, 0, 0.65);
    border-radius: 12px;
    border-width: 1px;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.25);

    opacity: 0;
    pointer-events: none;

    transition-property: opacity, translate;
    transition-duration: 1s;
    transition-timing-function: ease-out;
}

.enemy-attraction-panel.visible {
    opacity: 1;
    translate: -50% 0;
}

.enemy-attraction-bar-bg {
    width: 100%;
    height: 12px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.08);
    overflow: hidden;
}

.enemy-attraction-bar-fill {
    width: 0%;
    height: 100%;
    border-radius: 5px;
    background-color: rgba(154, 104, 255, 0.95);
    transition-property: width;
    transition-duration: 120ms;
    transition-timing-function: ease-out;
}


/* QUEST LOGGER */
.quest-logger-panel {
    position: absolute;
    top: 40px;
    left: 40px;

    min-width: 260px;
    max-width: 420px;

    padding: 14px 16px;
    border-radius: 12px;

    background-color: rgba(0, 0, 0, 0.55);

    display: flex;
    flex-direction: column;
    gap: 10px;

    pointer-events: none;
}

.quest-logger-title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgba(238, 238, 238, 1);
    letter-spacing: 0.5px;
}

.quest-logger-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.quest-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 10px;

    opacity: 1;
    translate: 0 0;

    transition-property: opacity, translate;
    transition-duration: 2s;
    transition-timing-function: ease-in-out;
}

.quest-check {
    width: 18px;
    height: 18px;

    border-radius: 3px; 
    border-width: 2px;
    border-style: solid;
    border-color: rgba(255, 255, 255, 0.85);

    background-color: rgba(255, 255, 255, 0.0);
}

.quest-text {
    font-size: 18px;
    color: rgba(255, 255, 255, 1);
}

.quest-item.completed .quest-check {
    background-color: rgba(255, 255, 255, 0.9);
}

.quest-item.completed .quest-text {
    opacity: 0.65;
    text-decoration: line-through;
}

.quest-item.fade-out {
    opacity: 0;
    translate: 10px 0;
}